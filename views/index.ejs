<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Study Task Tracker</title>
</head>
<body>
    <!-- Include navbar from partials folder -->
    <%- include('partials/navbar') %>

    <div class="container mt-5">
        <div class="text-center">
            <h1 class="mb-3">Welcome to Study Task Tracker</h1>

            <p class="lead">
                A simple web app to help students organise homework, project tasks and deadlines.
            </p>

            <p>
                You can add, view, edit and delete your study tasks easily.
            </p>

            <div class="mt-4">
                <a href="/add" class="btn btn-primary me-2">Add New Task</a>
                <a href="/tasks" class="btn btn-success">View All Tasks</a>
            </div>
        </div>
    </div>
</body>
</html>