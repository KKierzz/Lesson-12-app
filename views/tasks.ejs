<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>View Tasks</title>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container mt-5">
        <h1 class="mb-4">View Study Tasks</h1>

        <% if (tasks.length === 0) { %>
            <div class="alert alert-info">
                No tasks added yet.
            </div>

            <a href="/add" class="btn btn-primary">Add Your First Task</a>
        <% } else { %>
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Title</th>
                        <th>Module</th>
                        <th>Deadline</th>
                        <th>Priority</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    <% tasks.forEach(task => { %>
                        <tr>
                            <td><%= task.title %></td>
                            <td><%= task.taskModule %></td>
                            <td><%= task.deadline %></td>
                            <td><%= task.priority %></td>
                            <td>
                                <a href="/edit/<%= task.id %>" class="btn btn-warning btn-sm">Edit</a>
                                <a href="/delete/<%= task.id %>" class="btn btn-danger btn-sm">Delete</a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

            <a href="/add" class="btn btn-primary">Add Another Task</a>
        <% } %>
    </div>
</body>
</html>